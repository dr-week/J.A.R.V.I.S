{
  "mcpServers": {
    "postiz": {
      "command": "npx",
      "args": [
        "-y",
        "@postiz/mcp-server"
      ],
      "env": {
        "POSTIZ_API_KEY": "pos_live_key_here",
        "POSTIZ_URL": "http://localhost:3000"
      }
    },
    "n8n": {
      "command": "npx",
      "args": [
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "N8N_API_KEY": "n8n_api_key_here",
        "N8N_URL": "http://localhost:5678"
      }
    }
  }
}
