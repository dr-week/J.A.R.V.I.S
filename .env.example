# Environment example — copy to .env (never commit .env)

# ── Identity ──────────────────────────────────────────────
ASSISTANT_NAME=Jarvis

# ── LLM (brain only — never ship to clients) ──────────────
JARVIS_LLM_PROVIDER=gemini
# Options: gemini | openai | ollama | litellm
GEMINI_API_KEY=
JARVIS_LLM_MODEL=gemini-2.0-flash
# LM Studio example:
# JARVIS_LLM_PROVIDER=openai
# JARVIS_LLM_BASE_URL=http://127.0.0.1:1234/v1
# JARVIS_LLM_MODEL=your-model-id
# JARVIS_LLM_API_KEY=lm-studio
# LiteLLM gateway example:
# JARVIS_LLM_PROVIDER=litellm
# JARVIS_LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# JARVIS_LITELLM_MODEL=gemini-2.0-flash
# JARVIS_LITELLM_API_KEY=sk-your-gateway-key
JARVIS_LLM_BASE_URL=
JARVIS_LLM_API_KEY=
JARVIS_LITELLM_MODEL=
JARVIS_LITELLM_BASE_URL=
JARVIS_LITELLM_API_KEY=

# ── Brain server ──────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787
JARVIS_DATA_DIR=./data
JARVIS_CORS_ORIGINS=*

# ── Pairing / Auth ────────────────────────────────────────
JARVIS_PAIRING_SECRET=change-me-to-something-random
JARVIS_JWT_SECRET=change-me-to-something-random
JARVIS_JWT_EXPIRE_DAYS=30

# ── Learning ──────────────────────────────────────────────
LEARNING_ENABLED=true
LEARNING_MIN_OCCURRENCES=3

# ── Velocity ──────────────────────────────────────────────
JARVIS_VELOCITY_URL=http://127.0.0.1:5174
# JARVIS_VELOCITY_ROOT=

# Optional extras
NEWS_API_KEY=
