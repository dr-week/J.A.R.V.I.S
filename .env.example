# Environment example — copy to .env (never commit .env)
# All JARVIS_* vars can be overridden per environment.

# ── Identity ──────────────────────────────────────────────
ASSISTANT_NAME=Jarvis
# Can be changed to Friday, Atlas, or any name. No code change needed.

# ── LLM (brain only — never ship to clients) ──────────────
JARVIS_LLM_PROVIDER=gemini
# Options: gemini | openai | ollama

GEMINI_API_KEY=
# Get from https://aistudio.google.com/app/apikey

JARVIS_LLM_MODEL=gemini-2.0-flash
# Override model. gemini-2.5-pro for best reasoning.

JARVIS_LLM_BASE_URL=
# For OpenAI-compatible: https://api.openai.com/v1 or local ollama URL

JARVIS_LLM_API_KEY=
# Only needed if JARVIS_LLM_PROVIDER=openai

# ── Brain server ──────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787
JARVIS_DATA_DIR=./data

# ── Pairing / Auth ────────────────────────────────────────
JARVIS_PAIRING_SECRET=change-me-to-something-random
JARVIS_JWT_SECRET=change-me-to-something-random
JARVIS_JWT_EXPIRE_DAYS=30

# ── Learning ──────────────────────────────────────────────
LEARNING_ENABLED=true
# Set false to disable passive observation and habit detection
LEARNING_MIN_OCCURRENCES=3
# How many times a pattern must repeat before becoming a habit

# GitHub connector (brain only -- never ship to clients)
JARVIS_GITHUB_TOKEN=
# Fine-grained personal access token or OAuth access token with repository issue read access.
JARVIS_GITHUB_REPOSITORY=
# Optional default repository in owner/repository form.
